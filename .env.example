# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_NAME=distributed_transaction_processing
DATABASE_USER=dtp_user
DATABASE_PASSWORD=dtp_password
DATABASE_PORT=5432
DATABASE_URL=postgresql://dtp_user:dtp_password@localhost:5432/distributed_transaction_processing

# AWS / MiniStack
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566
DOCKER_AWS_ENDPOINT_URL=http://ministack:4566
DOCKER_SQS_ENDPOINT=http://ministack:4566

# SQS consumer
SQS_CONSUMER_ENABLED=true
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5

# Transactional Outbox publisher
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=1000
OUTBOX_QUEUE_NAME=wager-events.fifo

# Pending reference worker
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_WORKER_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_ATTEMPTS=8
